{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "lint-luals",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc",
    "build": "pnpm run typecheck && tsx scripts/build.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@d4isdavid/config": "^0.1.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1"
    }
  }
}
